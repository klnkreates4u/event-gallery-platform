# ============================================================
# EVENT GALLERY PLATFORM — ENVIRONMENT VARIABLES
# Version: 1.0.0 (Release Candidate)
# ============================================================
# Copy this file to .env and fill in the values.

# ─── Application ──────────────────────────────────────────
DATABASE_URL="postgresql://username:password@localhost:5432/event_gallery"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="change-this-to-a-secure-random-string-min-32-chars"

# ─── Service Providers ────────────────────────────────────
# Options: LOCAL | CLOUDFLARE_R2 | AMAZON_S3 | GOOGLE_DRIVE | DROPBOX | CLOUDINARY | BACKBLAZE
STORAGE_PROVIDER="LOCAL"

# Options: CONSOLE | RESEND | SENDGRID | BREVO | SMTP
EMAIL_PROVIDER="CONSOLE"

# Options: LOCAL | GOOGLE_ANALYTICS | POSTHOG | PLAUSIBLE | VERCEL
ANALYTICS_PROVIDER="LOCAL"

# ─── Cloudflare R2 ────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_R2_BUCKET=""
CLOUDFLARE_R2_ACCESS_KEY=""
CLOUDFLARE_R2_SECRET_KEY=""

# ─── Amazon S3 ────────────────────────────────────────────
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

# ─── Google Drive ─────────────────────────────────────────
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_SECRET=""
GOOGLE_DRIVE_REDIRECT_URI=""

# ─── Email: Resend ────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# ─── Email: SendGrid ──────────────────────────────────────
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""

# ─── Analytics: Google Analytics ──────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# ─── Analytics: PostHog ───────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ─── Analytics: Plausible ─────────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# ─── Error Monitoring: Sentry (Future) ────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
